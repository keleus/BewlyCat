{
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },

  "cSpell.words": [
    "Attributify",
    "bangumi",
    "bcoin",
    "bewly",
    "bili",
    "bilibili",
    "bvid",
    "carplay",
    "Danmaku",
    "danmakus",
    "dompurify",
    "favlist",
    "iconfont",
    "lightoff",
    "mingcute",
    "minimlistic",
    "noti",
    "notrigger",
    "owari",
    "pagefullscreen",
    "pinia",
    "prismjs",
    "pswp",
    "pubdate",
    "replys",
    "squirtle",
    "tabler",
    "toastification",
    "topbar",
    "unocss",
    "videocamera",
    "Vitesse",
    "vitesse-webext",
    "vueuse",
    "WATCHLATER",
    "webext",
    "webextension"
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "vite.autoStart": false,
  "files.associations": {
    "*.css": "postcss"
  },
  "i18n-ally.localesPaths": ["src/_locales"],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "cmn-CN"
}
